# Local host API (Nest on the machine) + Postgres via docker:dev (published on host :5433):
DATABASE_URL="postgresql://atasoif:atasoif@localhost:5433/atasoif_v2?schema=public"

# Full Docker stack (API container talks to Postgres service name on internal :5432):
# DATABASE_URL="postgresql://atasoif:atasoif@postgres:5432/atasoif_v2?schema=public"

POSTGRES_USER="atasoif"
POSTGRES_PASSWORD="atasoif"
POSTGRES_DB="atasoif_v2"
API_PORT="3000"

BETTER_AUTH_SECRET="change-me-min-32-chars-long-secret!!"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
CORS_ORIGIN="http://localhost:4200"
