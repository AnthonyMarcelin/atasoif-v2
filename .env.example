# Local host API (Adonis on the machine) + Postgres via docker:dev (published on host :5432):
DB_HOST=localhost
DB_PORT=5432
DB_USER=atasoif
DB_PASSWORD=atasoif
DB_DATABASE=atasoif_v2

# Full Docker stack (API container talks to Postgres service name):
# DB_HOST=postgres

POSTGRES_USER=atasoif
POSTGRES_PASSWORD=atasoif
POSTGRES_DB=atasoif_v2
API_PORT=3000

# Generate with: node ace generate:key (from apps/api)
APP_KEY=
APP_URL=http://localhost:3000
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
SESSION_DRIVER=cookie
CORS_ORIGIN=http://localhost:4200

# Ally (OAuth login — Google / Facebook built-in; Apple = custom driver, see E1-T09)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Catalog enrichment (also set in apps/api/.env for host-run API)
# See docs/CATALOG-NURSE.md — trial UPCitemdb needs no key
OFF_API_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=Atasoif/0.1 (hello@atasoif.local)
UPCITEMDB_ENABLED=true
# Trial: https://api.upcitemdb.com/prod/trial (GET …/lookup, no key, ~100 req/day)
UPCITEMDB_API_BASE_URL=https://api.upcitemdb.com/prod/trial
# Optional paid plan only — leave empty for trial
UPCITEMDB_USER_KEY=
UPCITEMDB_KEY_TYPE=3scale
CATALOG_NURSE_DAILY_LIMIT=100
# Catalog image mirror (optional — catalog:off-dump --mirror-images)
CATALOG_IMAGE_STORAGE_PATH=
CATALOG_IMAGE_PUBLIC_BASE_URL=

# Cellar photo uploads (also set in apps/api/.env). See apps/api/.env.example.
# CELLAR_PHOTO_DIR=/var/lib/atasoif/cellar-photos
CELLAR_PHOTO_MAX_BYTES=5242880

# Ops KPI read API. Header X-Ops-Token. Empty keeps the route closed.
OPS_ADMIN_TOKEN=
