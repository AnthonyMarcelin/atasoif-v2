# Node
TZ=UTC
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
# Generate with: node ace generate:key
APP_KEY=
APP_URL=http://localhost:3000
# Frontend (apps/web) — used in verify / reset email links
WEB_URL=http://localhost:4200

# Session
SESSION_DRIVER=cookie

# Database (Postgres) — Lucid connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=atasoif
DB_PASSWORD=atasoif
DB_DATABASE=atasoif_v2

# CORS — comma-separated origins (apps/web default :4200)
CORS_ORIGIN=http://localhost:4200

# Ally placeholders (OAuth wired in E1-T07+)
# Ally — Google
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder

# Ally — Facebook
FACEBOOK_CLIENT_ID=placeholder
FACEBOOK_CLIENT_SECRET=placeholder

# Ally — Apple (custom driver — E1-T09)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Mail (@adonisjs/mail) — SMTP
# Dev: Mailpit (http://localhost:8025 UI, SMTP :1025) or Ethereal credentials.
# Prod provider swap deferred (E0.7); keep log/catcher until then.
MAIL_MAILER=smtp
MAIL_FROM_NAME=À ta soif
MAIL_FROM_ADDRESS=noreply@atasoif.local
SMTP_HOST=localhost
SMTP_PORT=1025
# Optional — leave empty for local Mailpit without auth
SMTP_USERNAME=
SMTP_PASSWORD=
