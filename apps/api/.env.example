# Node
TZ=UTC
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
# Generate with: node ace generate:key
APP_KEY=
APP_URL=http://localhost:3000
# Angular / Capacitor origin for mail deep links (verify + reset)
FRONTEND_URL=http://localhost:4200

# Session
SESSION_DRIVER=cookie

# Database (Postgres) — Lucid connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=atasoif
DB_PASSWORD=atasoif
DB_DATABASE=atasoif_v2

# CORS — comma-separated origins (apps/web default :4200)
CORS_ORIGIN=http://localhost:4200

# Ally — Google (E1-T07)
# Create OAuth client in Google Cloud Console; authorized redirect URI:
#   {APP_URL}/api/v1/auth/google/callback
# Local example: http://localhost:3000/api/v1/auth/google/callback
# Start URL (Angular button): {APP_URL}/api/v1/auth/google/redirect
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder

# Ally — Facebook (E1-T08) — login only, no friends graph
# Meta Developer app; Valid OAuth Redirect URI:
#   {APP_URL}/api/v1/auth/facebook/callback
# Local example: http://localhost:3000/api/v1/auth/facebook/callback
# Start URL: {APP_URL}/api/v1/auth/facebook/redirect
# Scopes: email + public_profile only (never user_friends)
FACEBOOK_CLIENT_ID=placeholder
FACEBOOK_CLIENT_SECRET=placeholder

# Ally — Apple (custom driver — E1-T09)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Mail — SMTP (Mailpit in local/dev: UI http://localhost:8025, SMTP :1025)
MAIL_MAILER=smtp
MAIL_FROM_NAME=À ta soif
MAIL_FROM_ADDRESS=hello@atasoif.local
SMTP_HOST=localhost
SMTP_PORT=1025
# Leave empty for Mailpit; set for real SMTP providers
SMTP_USERNAME=
SMTP_PASSWORD=

# Catalog — Open Food Facts (primary live miss) + UPCitemdb nurse fallback
# OFF requires a descriptive User-Agent: AppName/Version (contact)
OFF_API_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=Atasoif/0.1 (hello@atasoif.local)
# UPCitemdb trial lookup: NO API key required
#   GET https://api.upcitemdb.com/prod/trial/lookup?upc=…
#   Docs: https://www.upcitemdb.com/api/explorer#!/lookup/get_trial_lookup
#   Trial soft limit ~100 req/day — nurse also throttles via CATALOG_NURSE_DAILY_LIMIT
# Paid later (optional): UPCITEMDB_API_BASE_URL=https://api.upcitemdb.com/prod/v1 + UPCITEMDB_USER_KEY
UPCITEMDB_ENABLED=true
UPCITEMDB_API_BASE_URL=https://api.upcitemdb.com/prod/trial
# Leave empty for trial — scaffold must not block on a missing key
UPCITEMDB_USER_KEY=
UPCITEMDB_KEY_TYPE=3scale
# Nurse Ace (`node ace catalog:nurse`) — our daily remote budget (default 100)
CATALOG_NURSE_DAILY_LIMIT=100
# Catalog image mirror (Ace catalog:off-dump --mirror-images) — local VPS disk; R2 later
# Leave empty until ops creates the directory; without it, photoUrl stays the OFF remote URL
CATALOG_IMAGE_STORAGE_PATH=
# Optional public URL prefix once static serving exists (e.g. https://api.atasoif.fr/media/catalog)
CATALOG_IMAGE_PUBLIC_BASE_URL=

# Cellar photos (E2-T04) — local disk, outside the release directory in production.
# Shelf override: POST /api/v1/collection/bottles/:id/photo (premium) served owner-only at the same path.
# Catalog packshot on a miss: multipart field catalogPhoto, served at /api/v1/media/catalog/:name (auth).
# Unset in tests: the API uses a temp directory. Required for a real upload environment.
# CELLAR_PHOTO_DIR=/var/lib/atasoif/cellar-photos
# Max upload size in bytes (jpeg, png, webp). Default 5242880 (5 MiB) when unset.
CELLAR_PHOTO_MAX_BYTES=5242880

# Ops KPI read API (E2-T09). Header X-Ops-Token, not a user Bearer token.
# Leave empty to keep GET /api/v1/ops/kpis closed. Use a long random value in production.
OPS_ADMIN_TOKEN=
