# Node
TZ=UTC
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
# Generate with: node ace generate:key
APP_KEY=
APP_URL=http://localhost:3000
# Angular / Capacitor origin for mail deep links (verify + reset). Prod landing: https://www.atasoif.fr
FRONTEND_URL=http://localhost:4200
# Capacitor OAuth return deep link (optional at boot). Native Ally handoff = follow-up ticket.
# Prod placeholder: fr.atasoif.app://auth/callback
NATIVE_OAUTH_RETURN_URL=

# Session
SESSION_DRIVER=cookie

# Database (Postgres) — Lucid connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=atasoif
DB_PASSWORD=atasoif
DB_DATABASE=atasoif_v2
# Docker entrypoint only: set to 1/true to run `node ace migration:run --force` on boot.
# Leave unset/0 in Dokploy prod (live data). Local `docker:dev` sets RUN_MIGRATIONS=1.
# RUN_MIGRATIONS=0

# E2-T11 one-shot: Railway v1 public URL for password hashes (Ace migrate:v1).
# Never commit the real value. JSON exports do not include hashes.
# DATABASE_PUBLIC_URL=

# CORS — comma-separated origins
# Local: Angular default :4200
# Prod Capacitor / stores: marketing HTTPS + Capacitor WebView origins
# CORS_ORIGIN=https://www.atasoif.fr,https://atasoif.fr,capacitor://localhost,https://localhost
CORS_ORIGIN=http://localhost:4200

# Ally — Google (E1-T07)
# Create OAuth client in Google Cloud Console; authorized redirect URI:
#   {APP_URL}/api/v1/auth/google/callback
# Local example: http://localhost:3000/api/v1/auth/google/callback
# Start URL (Angular button): {APP_URL}/api/v1/auth/google/redirect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ally — Facebook (E1-T08) — login only, no friends graph
# Meta Developer app; Valid OAuth Redirect URI:
#   {APP_URL}/api/v1/auth/facebook/callback
# Local example: http://localhost:3000/api/v1/auth/facebook/callback
# Start URL: {APP_URL}/api/v1/auth/facebook/redirect
# Scopes: email + public_profile only (never user_friends)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Ally — Apple Sign In (custom driver — E1-T09)
# Services ID (web): com.atasoif.web
# Return URL: {APP_URL}/api/v1/auth/apple/callback
# Start URL:  {APP_URL}/api/v1/auth/apple/redirect
# Client secret JWT is generated at runtime from the .p8 key (no static 6-month secret).
APPLE_CLIENT_ID=com.atasoif.web
APPLE_TEAM_ID=D3UKXNVT3D
APPLE_KEY_ID=
# PEM contents of the Apple .p8 key (escape newlines as \n in single-line env if needed). Never commit.
APPLE_PRIVATE_KEY=
# Legacy static client_secret JWT — leave empty when TEAM/KEY/PEM are set.
APPLE_CLIENT_SECRET=
# iOS bundle id — optional until native SIWA / Capacitor ticket
APPLE_BUNDLE_ID=fr.atasoif.app

# Mail — SMTP (Mailpit in local/dev: UI http://localhost:8025, SMTP :1025)
MAIL_MAILER=smtp
MAIL_FROM_NAME=À ta soif
MAIL_FROM_ADDRESS=hello@atasoif.local
SMTP_HOST=localhost
SMTP_PORT=1025
# Leave empty for Mailpit; set for real SMTP providers
SMTP_USERNAME=
SMTP_PASSWORD=

# Catalog — Open Food Facts (primary live miss) + UPCitemdb nurse fallback
# OFF requires a descriptive User-Agent: AppName/Version (contact)
OFF_API_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=Atasoif/0.1 (hello@atasoif.local)
# UPCitemdb trial lookup: NO API key required
#   GET https://api.upcitemdb.com/prod/trial/lookup?upc=…
#   Docs: https://www.upcitemdb.com/api/explorer#!/lookup/get_trial_lookup
#   Trial soft limit ~100 req/day — nurse also throttles via CATALOG_NURSE_DAILY_LIMIT
# Paid later (optional): UPCITEMDB_API_BASE_URL=https://api.upcitemdb.com/prod/v1 + UPCITEMDB_USER_KEY
UPCITEMDB_ENABLED=true
UPCITEMDB_API_BASE_URL=https://api.upcitemdb.com/prod/trial
# Leave empty for trial — scaffold must not block on a missing key
UPCITEMDB_USER_KEY=
UPCITEMDB_KEY_TYPE=3scale
# Nurse Ace (`node ace catalog:nurse`) — our daily remote budget (default 100)
CATALOG_NURSE_DAILY_LIMIT=100
# Catalog image mirror (Ace catalog:mirror-images / catalog:off-dump --mirror-images)
# Persistent volume in prod, e.g. /var/lib/atasoif/catalog-images (not /tmp).
# Leave empty until ops creates the directory; without it, photoUrl stays the OFF remote URL.
CATALOG_IMAGE_STORAGE_PATH=
# Optional public URL prefix. Default when empty: /api/v1/media/off (auth route showOffCatalog).
# CATALOG_IMAGE_PUBLIC_BASE_URL=/api/v1/media/off
CATALOG_IMAGE_PUBLIC_BASE_URL=

# Cellar photos (E2-T04) — local disk, outside the release directory in production.
# Shelf override: POST /api/v1/collection/bottles/:id/photo (premium) served owner-only at the same path.
# Catalog packshot on a miss: multipart field catalogPhoto, served at /api/v1/media/catalog/:name (auth).
# Unset in tests: the API uses a temp directory. Required for a real upload environment.
# CELLAR_PHOTO_DIR=/var/lib/atasoif/cellar-photos
# Sync Sharp/HEIC threshold (default 2 MiB). Heavier uploads → @adonisjs/queue job.
CELLAR_PHOTO_SYNC_MAX_BYTES=2097152
# Absolute max upload (jpeg/png/webp/heic). Default 10 MiB when unset.
CELLAR_PHOTO_MAX_BYTES=10485760
# Queue adapter: sync (inline, default) or database (+ `node ace queue:work`).
QUEUE_DRIVER=sync

# Ops KPI read API (E2-T09). Header X-Ops-Token, not a user Bearer token.
# Leave empty to keep GET /api/v1/ops/kpis closed. Use a long random value in production.
OPS_ADMIN_TOKEN=