# Node
TZ=UTC
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
# Generate with: node ace generate:key
APP_KEY=
APP_URL=http://localhost:3000
# Angular / Capacitor origin for mail deep links (verify + reset)
FRONTEND_URL=http://localhost:4200

# Session
SESSION_DRIVER=cookie

# Database (Postgres) — Lucid connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=atasoif
DB_PASSWORD=atasoif
DB_DATABASE=atasoif_v2

# CORS — comma-separated origins (apps/web default :4200)
CORS_ORIGIN=http://localhost:4200

# Ally — Google (E1-T07)
# Create OAuth client in Google Cloud Console; authorized redirect URI:
#   {APP_URL}/api/v1/auth/google/callback
# Local example: http://localhost:3000/api/v1/auth/google/callback
# Start URL (Angular button): {APP_URL}/api/v1/auth/google/redirect
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder

# Ally — Facebook
FACEBOOK_CLIENT_ID=placeholder
FACEBOOK_CLIENT_SECRET=placeholder

# Ally — Apple (custom driver — E1-T09)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Mail — SMTP (Mailpit in local/dev: UI http://localhost:8025, SMTP :1025)
MAIL_MAILER=smtp
MAIL_FROM_NAME=À ta soif
MAIL_FROM_ADDRESS=hello@atasoif.local
SMTP_HOST=localhost
SMTP_PORT=1025
# Leave empty for Mailpit; set for real SMTP providers
SMTP_USERNAME=
SMTP_PASSWORD=
