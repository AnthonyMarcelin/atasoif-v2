# Node
TZ=UTC
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
# Generate with: node ace generate:key
APP_KEY=
APP_URL=http://localhost:3000

# Session
SESSION_DRIVER=cookie

# Database (Postgres) — Lucid connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=atasoif
DB_PASSWORD=atasoif
DB_DATABASE=atasoif_v2

# CORS — comma-separated origins (apps/web default :4200)
CORS_ORIGIN=http://localhost:4200

# Ally placeholders (OAuth wired in E1-T07+)
# Ally — Google
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder

# Ally — Facebook
FACEBOOK_CLIENT_ID=placeholder
FACEBOOK_CLIENT_SECRET=placeholder

# Ally — Apple (custom driver — E1-T09)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=