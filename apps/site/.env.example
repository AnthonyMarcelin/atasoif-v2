# Public site URL (canonical + OG). Used at build time.
PUBLIC_SITE_URL=https://atasoif.fr

# CTA mode: waitlist (pre-launch email) | stores (App Store / Play links)
PUBLIC_CTA_MODE=waitlist

# Store URLs - replace before switching PUBLIC_CTA_MODE=stores
PUBLIC_IOS_URL=#ios
PUBLIC_ANDROID_URL=#android

# --- Runtime (Node standalone / Dokploy service `site`) ---
# Resend API key — never commit the real value.
# Create at https://resend.com/api-keys
RESEND_API_KEY=

# From address must use a Resend-verified domain (atasoif.fr).
# Dashboard: https://resend.com/domains → add atasoif.fr → DNS records:
#   - TXT  (SPF)     Resend-provided
#   - TXT  (DKIM)    Resend-provided (often resend._domainkey)
#   - optional DMARC / MX for inbound (not required for waitlist send)
# Keep API transactional mail on OVH SMTP (apps/api); Resend is site-only.
RESEND_FROM=À ta soif <noreply@atasoif.fr>
RESEND_REPLY_TO=contact@atasoif.fr

# Internal copy of each waitlist signup (set empty to disable)
WAITLIST_NOTIFY_TO=contact@atasoif.fr
