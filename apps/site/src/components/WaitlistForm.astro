---
interface Props {
  align?: 'start' | 'center';
  note?: string;
}

const {
  align = 'start',
  note = 'SORTIE PRÉVUE CET AUTOMNE · IOS ET ANDROID · UN SEUL EMAIL, PAS DE NEWSLETTER',
} = Astro.props;
---

<form class:list={['waitlist', align === 'center' && 'waitlist--center']} data-waitlist>
  <div class="waitlist__row">
    <label class="sr-only" for={`email-${align}`}>Email</label>
    <input
      id={`email-${align}`}
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="ton@email.fr"
      data-waitlist-input
    />
    <button type="submit">Être prévenu</button>
  </div>
  <p class="waitlist__note" data-waitlist-note role="status" aria-live="polite">{note}</p>
</form>

<style lang="scss">
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .waitlist {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 480px;
    width: 100%;

    &--center {
      align-items: center;
      max-width: 460px;
    }
  }

  .waitlist__row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    width: 100%;
  }

  input {
    flex: 1;
    min-width: 180px;
    height: 54px;
    border: var(--stroke) solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-ink);
    padding: 0 14px;
    font-size: 16px;
    border-radius: var(--radius);

    &:focus {
      outline: none;
      border: var(--stroke-accent) solid var(--color-accent);
    }

    &:disabled {
      opacity: 0.7;
    }
  }

  button {
    height: 54px;
    padding: 0 22px;
    border: var(--stroke) solid var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    cursor: pointer;
    white-space: nowrap;
    border-radius: var(--radius);
    transition: background var(--dur-tap) var(--ease);

    &:hover:not(:disabled) {
      background: var(--color-accent-hover);
      border-color: var(--color-accent-hover);
    }

    &:disabled {
      cursor: wait;
      opacity: 0.85;
    }
  }

  .waitlist__note {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-faint);
    letter-spacing: 0.06em;
  }

  .waitlist__note--ok,
  .waitlist__note--err,
  .waitlist__note--pending {
    font-family: var(--font-body);
    font-size: 15px;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .waitlist__note--ok {
    color: var(--color-success);
    padding: 12px 14px;
    border: var(--stroke) solid var(--color-success-border);
    background: var(--color-success-bg);
  }

  .waitlist__note--err {
    color: var(--color-danger);
  }

  .waitlist__note--pending {
    color: var(--color-ink-muted);
  }

  .waitlist--center .waitlist__note {
    text-align: center;
  }
</style>

<script>
  const SUCCESS_NOTE = 'C’est noté, on t’écrit à la sortie.';
  const PENDING_NOTE = 'Envoi en cours…';
  const FALLBACK_ERR = 'Oups, réessaie dans un instant.';

  document.querySelectorAll<HTMLFormElement>('[data-waitlist]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const note = form.querySelector<HTMLElement>('[data-waitlist-note]');
      const input = form.querySelector<HTMLInputElement>('[data-waitlist-input]');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!input?.checkValidity()) {
        input?.reportValidity();
        return;
      }

      const email = input.value.trim();
      const previousNote = note?.dataset.defaultNote ?? note?.textContent ?? '';
      if (note && !note.dataset.defaultNote) {
        note.dataset.defaultNote = previousNote;
      }

      if (button) button.disabled = true;
      if (input) input.disabled = true;
      if (note) {
        note.classList.remove('waitlist__note--ok', 'waitlist__note--err', 'waitlist__note--pending');
        note.classList.add('waitlist__note--pending');
        note.textContent = PENDING_NOTE;
      }

      try {
        const response = await fetch('/api/waitlist', {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ email }),
        });
        const body = (await response.json().catch(() => ({}))) as {
          message?: string;
        };

        if (!response.ok) {
          if (note) {
            note.classList.remove('waitlist__note--pending');
            note.classList.add('waitlist__note--err');
            note.textContent =
              typeof body.message === 'string' && body.message
                ? body.message
                : FALLBACK_ERR;
          }
          return;
        }

        if (note) {
          note.classList.remove('waitlist__note--pending');
          note.classList.add('waitlist__note--ok');
          note.textContent = SUCCESS_NOTE;
        }
        form.reset();
      } catch {
        if (note) {
          note.classList.remove('waitlist__note--pending');
          note.classList.add('waitlist__note--err');
          note.textContent = FALLBACK_ERR;
        }
      } finally {
        if (button) button.disabled = false;
        if (input) input.disabled = false;
        if (note && note.textContent === PENDING_NOTE) {
          note.classList.remove('waitlist__note--pending');
          note.textContent = note.dataset.defaultNote ?? previousNote;
        }
      }
    });
  });
</script>
